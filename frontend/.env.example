DATABASE_URL=postgresql://USUARIO:CLAVE@HOST:5432/postgres
# DATABASE_SSL_CA=
NEXT_PUBLIC_API_URL=http://localhost:3000/api
# Autenticación (obligatorias). AUTH_SECRET: >=32 caracteres aleatorios (openssl rand -base64 48)
AUTH_SECRET=
# AUTH_PIN_*: clave inicial de los usuarios admin / asistente / cajero (solo se usa la primera vez para crearlos; luego cada
# usuario cambia la suya y el administrador gestiona usuarios en el módulo Usuarios).
AUTH_PIN_ADMIN=
AUTH_PIN_ASISTENTE=
AUTH_PIN_CAJERO=
# DATABASE_SSL=false   # solo para BD local de desarrollo
# Archivos de resultados (Supabase Storage): Settings → API → URL y service_role key (solo servidor, nunca NEXT_PUBLIC)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# APP_URL=https://tu-sistema.vercel.app   # opcional: base de los enlaces de resultados
